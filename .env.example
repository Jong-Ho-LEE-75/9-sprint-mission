# === Database (Docker Compose 로컬) ===
POSTGRES_DB=discodeit
POSTGRES_USER=discodeit_user
POSTGRES_PASSWORD=discodeit1234

# === Application ===
APP_PORT=8080

# === AWS RDS (prod 프로파일) ===
DB_HOST=your-rds-endpoint.region.rds.amazonaws.com
DB_PORT=5432
DB_NAME=discodeit
DB_USERNAME=postgres
DB_PASSWORD=your-password

# === Storage ===
STORAGE_TYPE=local
STORAGE_LOCAL_ROOT_PATH=.discodeit/storage

# === AWS S3 (STORAGE_TYPE=s3 일 때 필요) ===
AWS_S3_ACCESS_KEY=your-access-key
AWS_S3_SECRET_KEY=your-secret-key
AWS_S3_REGION=ap-northeast-2
AWS_S3_BUCKET=discodeit-binary-content-storage-xxx
AWS_S3_PRESIGNED_URL_EXPIRATION=600
