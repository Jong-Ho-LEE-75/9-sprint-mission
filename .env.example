# === Database (Docker Compose 로컬) ===
POSTGRES_DB=discodeit
POSTGRES_USER=discodeit_user
POSTGRES_PASSWORD=discodeit1234

# === Application ===
APP_PORT=8080

# === AWS RDS (prod 프로파일) ===
DB_HOST=discodeit-db.cpk6ag6ga2mu.ap-northeast-2.rds.amazonaws.com
DB_PORT=5432
DB_NAME=discodeit
DB_USERNAME=postgres
DB_PASSWORD=discodeit1234

# === Storage ===
STORAGE_TYPE=s3
STORAGE_LOCAL_ROOT_PATH=.discodeit/storage

# === AWS S3 ===
# AWS_S3_ACCESS_KEY=(보안상 제외 - GitHub Secrets로 관리)
# AWS_S3_SECRET_KEY=(보안상 제외 - GitHub Secrets로 관리)
AWS_S3_REGION=ap-northeast-2
AWS_S3_BUCKET=discodeit-storage
AWS_S3_PRESIGNED_URL_EXPIRATION=600
